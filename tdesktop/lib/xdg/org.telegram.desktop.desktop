[Desktop Entry]
Name=Deltagram
Comment=Secure decentralized chat
TryExec=Telegram
Exec=Telegram -- %U
Icon=org.telegram.desktop
Terminal=false
StartupWMClass=Deltagram
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/openpgp4fpr;x-scheme-handler/dcaccount;
Keywords=deltachat;delta;chat;im;messaging;messenger;email;chatmail;
Actions=quit;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true

[Desktop Action quit]
Exec=Telegram -quit
Name=Quit Deltagram
Icon=application-exit
